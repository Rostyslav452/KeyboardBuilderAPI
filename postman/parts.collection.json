{
    "info": {
        "_postman_id": "5af425f0-8b36-4e10-a242-634ad0b0c8c2",
        "name": "Parts API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "description": "Collection for parts endpoints with create and update payload examples."
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000/api/v1"
        },
        {
            "key": "accessToken",
            "value": ""
        },
        {
            "key": "partId",
            "value": "00000000-0000-0000-0000-000000000000"
        }
    ],
    "item": [
        {
            "name": "Get All Parts",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/parts?limit=10&offset=0&sort=ASC",
                    "host": ["{{baseUrl}}"],
                    "path": ["parts"],
                    "query": [
                        {
                            "key": "limit",
                            "value": "10"
                        },
                        {
                            "key": "offset",
                            "value": "0"
                        },
                        {
                            "key": "sort",
                            "value": "ASC"
                        }
                    ]
                }
            }
        },
        {
            "name": "Get Part By Id",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/parts/{{partId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["parts", "{{partId}}"]
                }
            }
        },
        {
            "name": "Create Parts",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "[\n  {\n    \"body\": {\n      \"type\": \"switch\",\n      \"name\": \"HMX Violet\",\n      \"price\": 22,\n      \"specs\": {\n        \"switchType\": \"Linear\",\n        \"pins\": \"5-pin\",\n        \"actuationForce\": 45,\n        \"travelDistance\": 3.6\n      }\n    }\n  },\n  {\n    \"body\": {\n      \"type\": \"case\",\n      \"name\": \"Tofu60\",\n      \"price\": 129,\n      \"specs\": {\n        \"formFactor\": \"60%\",\n        \"material\": \"Aluminum\",\n        \"mountStyle\": \"Gasket Mount\",\n        \"color\": \"Black\"\n      }\n    }\n  },\n  {\n    \"body\": {\n      \"type\": \"pcb\",\n      \"name\": \"DZ60 RGB\",\n      \"price\": 74,\n      \"specs\": {\n        \"formFactor\": \"60%\",\n        \"hotSwap\": true,\n        \"rgbSupport\": \"per-key\",\n        \"connection\": [\"USB-C\"]\n      }\n    }\n  },\n  {\n    \"body\": {\n      \"type\": \"keycap\",\n      \"name\": \"GMK Botanical 2\",\n      \"price\": 155,\n      \"specs\": {\n        \"profile\": \"Cherry\",\n        \"material\": \"ABS\",\n        \"legends\": \"Double-shot\",\n        \"language\": [\"EN\", \"UA\"]\n      }\n    }\n  }\n]"
                },
                "url": {
                    "raw": "{{baseUrl}}/parts",
                    "host": ["{{baseUrl}}"],
                    "path": ["parts"]
                }
            }
        },
        {
            "name": "Update Switch Part",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"type\": \"switch\",\n  \"name\": \"HMX Violet V2\",\n  \"price\": 24,\n  \"specs\": {\n    \"switchType\": \"Linear\",\n    \"pins\": \"5-pin\",\n    \"actuationForce\": 42,\n    \"travelDistance\": 3.5\n  }\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/parts/{{partId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["parts", "{{partId}}"]
                }
            }
        },
        {
            "name": "Update Case Part",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"type\": \"case\",\n  \"name\": \"Tofu60 Redux\",\n  \"price\": 139,\n  \"specs\": {\n    \"formFactor\": \"60%\",\n    \"material\": \"Aluminum\",\n    \"mountStyle\": \"Gasket Mount\",\n    \"color\": \"Silver\"\n  }\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/parts/{{partId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["parts", "{{partId}}"]
                }
            }
        },
        {
            "name": "Update PCB Part",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"type\": \"pcb\",\n  \"name\": \"DZ60 RGB V3\",\n  \"price\": 79,\n  \"specs\": {\n    \"formFactor\": \"60%\",\n    \"hotSwap\": true,\n    \"rgbSupport\": \"per-key\",\n    \"connection\": [\"USB-C\", \"Bluetooth\"]\n  }\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/parts/{{partId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["parts", "{{partId}}"]
                }
            }
        },
        {
            "name": "Update Keycap Part",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"type\": \"keycap\",\n  \"name\": \"GMK Botanical 2\",\n  \"price\": 160,\n  \"specs\": {\n    \"profile\": \"Cherry\",\n    \"material\": \"ABS\",\n    \"legends\": \"Double-shot\",\n    \"language\": [\"EN\", \"UA\"]\n  }\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/parts/{{partId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["parts", "{{partId}}"]
                }
            }
        },
        {
            "name": "Delete Part",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{accessToken}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/parts/{{partId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["parts", "{{partId}}"]
                }
            }
        }
    ]
}
