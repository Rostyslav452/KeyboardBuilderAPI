{
   "name": "mechanical_keyboard_builder_api",
   "version": "1.0.0",
   "description": "Mechanical Keyboard Builder API",
   "main": "./src/server.ts",
   "type": "module",
   "scripts": {
      "build": "tsc",
      "start": "node dist/server.js",
      "dev": "tsx watch --inspect=0.0.0.0 src/server.ts",
      "migration": "npx sequelize-cli db:migrate",
      "undo": "npx sequelize-cli db:undo",
      "seed": "npx sequelize-cli db:seed:all",
      "seed:undo": "npx sequelize-cli db:seed:undo:all",
      "lint": "eslint ./src",
      "lint:fix": "eslint --fix ./src",
      "format": "prettier --check ./src",
      "format:fix": "prettier --write ./src",
      "check-all": "npm run lint && npm run format",
      "fix-all": "npm run lint:fix && npm run format:fix",
      "prepare": "husky",
      "db:test:up": "docker compose -f docker-compose.test.yml --env-file .env.test up -d --wait",
      "db:test:down": "docker compose -f docker-compose.test.yml --env-file .env.test down -v",
      "test": "npm run db:test:up && node --env-file=.env.test ./node_modules/jest/bin/jest.js --runInBand && npm run db:test:down",
      "test:ci": "node ./node_modules/jest/bin/jest.js --runInBand"
   },
   "lint-staged": {
      "src/**/*.ts": [
         "prettier --write",
         "eslint --fix"
      ]
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/Rostyslav452/KeyboardBuilderAPI.git"
   },
   "author": "Rostyslav452 <rooostik2016@gmail.com>",
   "bugs": {
      "url": "https://github.com/Rostyslav452/KeyboardBuilderAPI/issues"
   },
   "homepage": "https://github.com/Rostyslav452/KeyboardBuilderAPI#readme",
   "dependencies": {
      "bcrypt": "^6.0.0",
      "cookie-parser": "^1.4.7",
      "cors": "^2.8.6",
      "dotenv": "^17.2.4",
      "express": "^5.2.1",
      "express-rate-limit": "^8.2.1",
      "helmet": "^8.1.0",
      "js-yaml": "^5.4.1",
      "jsonwebtoken": "^9.0.3",
      "mysql2": "^3.16.3",
      "pino": "^10.3.1",
      "pino-http": "^11.0.0",
      "sequelize": "^6.37.7",
      "sequelize-cli": "^6.6.5",
      "swagger-jsdoc": "^6.2.8",
      "swagger-ui-express": "^5.0.1",
      "uuid": "^13.0.0",
      "zod": "^4.3.6"
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "@types/bcrypt": "^6.0.0",
      "@types/cookie-parser": "^1.4.10",
      "@types/cors": "^2.8.19",
      "@types/express": "^5.0.6",
      "@types/jest": "^30.0.0",
      "@types/js-yaml": "^4.0.9",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/sequelize": "^4.28.20",
      "@types/supertest": "^7.2.1",
      "@types/swagger-ui-express": "^4.1.8",
      "@types/uuid": "^10.0.0",
      "eslint": "^10.8.0",
      "eslint-config-prettier": "^10.1.8",
      "globals": "^17.9.0",
      "husky": "^9.1.7",
      "jest": "^30.5.1",
      "lint-staged": "^16.4.0",
      "pino-pretty": "^13.1.3",
      "prettier": "^3.9.6",
      "supertest": "^7.2.2",
      "ts-jest": "^29.4.12",
      "tsx": "^4.21.0",
      "typescript": "^5.8.2",
      "typescript-eslint": "^8.66.0"
   }
}
